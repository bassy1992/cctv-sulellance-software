# Django Configuration
DEBUG=True
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (SQLite by default for desktop app)
DATABASE_URL=sqlite:///db.sqlite3

# Redis Configuration (for Celery and WebSockets)
REDIS_URL=redis://localhost:6379/0

# Storage Configuration
SURVEILLANCE_STORAGE_PATH=storage\recordings
SURVEILLANCE_TEMP_PATH=storage\temp
SURVEILLANCE_SNAPSHOTS_PATH=storage\snapshots

# FFmpeg Configuration
FFMPEG_PATH=ffmpeg
FFMPEG_HARDWARE_ACCELERATION=auto

# RTSP Configuration
RTSP_CONNECTION_TIMEOUT=10
RTSP_READ_TIMEOUT=30

# Recording Configuration
DEFAULT_RECORDING_DURATION=900
SEGMENT_DURATION=1800
RETENTION_DAYS=14

# System Configuration
MAX_CONCURRENT_RECORDINGS=6
MOTION_DETECTION_ENABLED=True
MOTION_SENSITIVITY=medium

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000